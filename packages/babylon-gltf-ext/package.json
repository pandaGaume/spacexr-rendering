{
    "name": "@spacexr/babylon-gltf-ext",
    "version": "0.1.0",
    "description": "Babylon.js loader, exporter and runtime of the SPACEXR_ground_reference glTF node extension.",
    "type": "module",
    "license": "Apache-2.0",
    "author": "Guillaume Pelletier (SpaceXR)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pandaGaume/spacexr-rendering.git",
        "directory": "packages/babylon-gltf-ext"
    },
    "homepage": "https://github.com/pandaGaume/spacexr-rendering#readme",
    "bugs": {
        "url": "https://github.com/pandaGaume/spacexr-rendering/issues"
    },
    "keywords": [
        "gltf",
        "babylonjs",
        "extensions",
        "spacexr"
    ],
    "engines": {
        "node": ">=20.11.0"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./loader": {
            "types": "./dist/loader.d.ts",
            "import": "./dist/loader.js",
            "default": "./dist/loader.js"
        },
        "./exporter": {
            "types": "./dist/exporter.d.ts",
            "import": "./dist/exporter.js",
            "default": "./dist/exporter.js"
        }
    },
    "scripts": {
        "build": "tsup",
        "clean": "rimraf dist coverage",
        "watch": "tsup --watch",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --coverage.enabled=false",
        "test:watch": "vitest",
        "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
        "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
        "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
        "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "peerDependencies": {
        "@babylonjs/core": "^9.33.1",
        "@babylonjs/loaders": "^9.33.1",
        "@babylonjs/serializers": "^9.33.1"
    },
    "peerDependenciesMeta": {
        "@babylonjs/loaders": {
            "optional": true
        },
        "@babylonjs/serializers": {
            "optional": true
        }
    },
    "devDependencies": {
        "@babylonjs/core": "^9.33.1",
        "@babylonjs/loaders": "^9.33.1",
        "@babylonjs/serializers": "9.33.1",
        "@types/node": "^20.11.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.5.7",
        "prettier": "^3.9.10",
        "rimraf": "~6.1.3",
        "tslib": "^2.9.1",
        "tsup": "^8.5.1",
        "typescript": "^5.4.0",
        "vitest": "4.1.12"
    }
}
